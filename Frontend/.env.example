# ========================================================
# INDIA-WIDE GIS LAND GOVERNANCE PLATFORM — FRONTEND ENV
# ========================================================

# Backend API Endpoint (NestJS API Gateway)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Backend Port (for direct proxy & reference)
VITE_BACKEND_PORT=3000

# Application Details
VITE_APP_NAME="National Cadastral Land Governance Platform"
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# GeoServer WMS / WFS Endpoint for Cadastral Layers
VITE_GEOSERVER_URL=http://localhost:8080/geoserver
VITE_GEOSERVER_WORKSPACE=national_cadastre

# Fallback & Latency Simulation
VITE_ENABLE_MOCK_FALLBACK=false
