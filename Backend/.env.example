# ==========================================
# INDIA-WIDE GIS LAND GOVERNANCE BACKEND ENV
# ==========================================

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL + PostGIS (Authoritative RDBMS & Spatial)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_land_pass
DATABASE_NAME=bhu_twin_db
DATABASE_SSL=false

# Neo4j (Ownership Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_secret_pass
NEO4J_DATABASE=neo4j

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka (Asynchronous Event Bus)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bhu-twin-core
KAFKA_GROUP_ID=bhu-twin-consumers

# S3-Compatible Object Storage / MinIO (Certified Deeds Vault)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_pass
S3_BUCKET=gov-land-vault-prod
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true

# OpenSearch (Read-Optimized Cadastral Search Layer)
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Admin@OpenSearch2026!

# GeoServer (WMS/WFS Layer Map Server)
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_WORKSPACE=national_cadastre

# Keycloak / OAuth 2.0 / JWT Auth
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=national-land-governance
KEYCLOAK_CLIENT_ID=bhu-twin-backend
JWT_SECRET=super_secret_gov_root_signing_key_2026_india
JWT_EXPIRATION=86400
